# Copy to .env.local and fill in. Never commit .env.local.

# Resend (required for /api/send-campaign to actually send email)
# RESEND_API_KEY=re_xxxxxxxx

# From address (must be a domain verified in Resend)
# SMOOTHSALES_FROM=Your Name <onboarding@resend.dev>

# App URL (used in webhooks / follow-up links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Same as Vercel: optional second key for ?access= only (lead-list scripts use this)
# SMOOTHSALES_BYPASS_KEY=

# Optional: override default gate password (default is 13lion$ales in code)
# SMOOTHSALES_PASSWORD=

# Vercel KV (optional — follow-up cron uses if set)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
